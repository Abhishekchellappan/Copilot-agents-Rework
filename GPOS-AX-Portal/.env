# LDAP / Active Directory Configuration
# Leave LDAP_SERVER blank to enable mock login mode
LDAP_SERVER=
LDAP_DOMAIN=
LDAP_BASE_DN=

# JWT Secret Key (change in production)
JWT_SECRET_KEY=gpos-ax-portal-secret-key-change-me

# ─── Bug Watchdog v2.0 Configuration ─────────────────────────────────────────
# Set BUG_WATCHDOG_ENABLED=true to activate the automated bug triage watchdog
BUG_WATCHDOG_ENABLED=false

# How often the watchdog polls Jira (seconds). Default: 300 (5 minutes)
BUG_WATCHDOG_INTERVAL_SECONDS=300

# Jira project key to watch for Bug tickets
BUG_WATCHDOG_PROJECT_KEY=SIGPOSDEV

# Optional: comma-separated Jira usernames to watch (in addition to portal DB users)
# If blank, the watchdog auto-detects all allowed users from the portal DB.
BUG_WATCHDOG_USERS=

# How many days back to look for updated/assigned bugs (catches reassigned bugs too)
BUG_WATCHDOG_LOOKBACK_DAYS=1

# Max bugs to process per cycle (processed in P1→P2→P3 priority order)
BUG_WATCHDOG_MAX_ISSUES_PER_CYCLE=10

# Jira PAT for watchdog (falls back to JIRA_PAT if blank)
BUG_WATCHDOG_JIRA_PAT=

# LLM endpoint & key for the watchdog's autonomous reasoning
BUG_WATCHDOG_LLM_URL=http://exacode-chat.lge.com/v1
BUG_WATCHDOG_LLM_KEY=

# Cooldown between re-reminders on still-Pending bugs (hours). Default: 24
BUG_WATCHDOG_REMIND_HOURS=24

# ─── SMTP for direct email delivery ──────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=gpos-ax-portal@lge.com
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
